# ---- 必填项 ----
JWT_SECRET=your-jwt-secret-here
AUTH_USERNAME=admin
AUTH_PASSWORD=your-password-here

# ---- 可选项 ----
# CORS：逗号分隔白名单；* 或 all 表示允许任意来源；也可用 CORS_ALLOW_ALL=true
ALLOWED_ORIGINS=http://localhost:28081
# CORS_ALLOW_ALL=false

# Cookie：true | false | auto（auto 在生产环境为 true）
COOKIE_SECURE=auto
# Cookie SameSite：lax | strict | none | auto（跨域 HTTPS 场景 auto 会选 none）
COOKIE_SAME_SITE=auto
# 前后端不同域且需携带 Cookie 时设为 true（会配合 COOKIE_SAME_SITE=none）
# CROSS_ORIGIN_COOKIES=false

PORT=33721
NODE_ENV=production

# ---- ADB 配置 ----
# ADB_MODE: host（连接宿主机 ADB）| local（容器内 ADB）| off（禁用）
ADB_MODE=local
ADB_HOST=127.0.0.1
ADB_PORT=5037
