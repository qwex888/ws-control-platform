# ---- 服务配置 ----
PORT=33721
NODE_ENV=production

# ---- ADB 配置 ----
# ADB_MODE: host（连接宿主机 ADB）| local（容器内 ADB）| off（禁用）
ADB_MODE=local
ADB_HOST=127.0.0.1
ADB_PORT=5037

# Docker 中连接宿主机 ADB:
# ADB_MODE=host
# ADB_HOST=host.docker.internal
# ADB_PORT=5037

# ---- 鉴权 ----
# JWT_SECRET 可选：不配置则通过 Web 初始化页面设置并持久化到 data/auth.json
# JWT_SECRET=your-secret-here
