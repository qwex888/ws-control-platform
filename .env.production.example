JWT_SECRET=your-jwt-secret-here
AUTH_USERNAME=admin
AUTH_PASSWORD=your-password-here

# 对外访问地址（用于推导 Cookie Secure：http:// 自动关闭 Secure）
PUBLIC_URL=http://192.168.31.249:28081

# CORS：逗号分隔白名单；* / all / CORS_ALLOW_ALL=true 表示不限制来源
ALLOWED_ORIGINS=http://192.168.31.249:28081
# ALLOWED_ORIGINS=*

# NAS 局域网 HTTP 部署务必 false；仅 HTTPS 反向代理时 true 或 auto
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
# 前后端分离部署在不同域名时：
# CROSS_ORIGIN_COOKIES=true

PORT=33721
NODE_ENV=production

# ADB_MODE: host（连接宿主机 ADB）| local（容器内 ADB）| off（禁用）
ADB_MODE=local
ADB_HOST=127.0.0.1
ADB_PORT=5037

# ADB_HOST 可选: 不设置时自动使用 host.docker.internal
#ADB_MODE=host
#ADB_HOST=host.docker.internal
#ADB_PORT=5037
